# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# The game app lives in client/, the regression suite in automation-testing/: the
# toolchain patterns below are unanchored so they hold in both.

# dependencies
node_modules/

# testing
/client/coverage/

# next.js
.next/
/client/out/
/client/out-auth/

# production
/client/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env files (can opt-in for commiting if needed)
.env*
!.env.example

# git worktrees
/.worktrees/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright (automation-testing/ and any local MCP session)
test-results/
playwright-report/
blob-report/
playwright/.cache/
.auth/
# Playwright MCP do snapshot trang ra day moi lan chay, khong phai file cua project
.playwright-mcp/

# --- Claude Code: theo doi config + skills, bo qua worktrees/doc-state ---
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.local.json
!/.claude/skills/
!/.claude/scripts/
!/.claude/agents/
